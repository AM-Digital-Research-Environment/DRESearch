<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var bool $configured
 * @var list<array{name:string, label:string, collection:string, reachable:bool, documents:?int, error:?string, state:array<string,mixed>}> $profiles
 * @var \DRESearch\Form\MaintenanceForm $form
 * @var array{enabled:bool,rows:list<array{profile:string,kind:string,q:string,count:int}>} $analytics
 * @var array{requested:bool,heartbeat:?string,alive:bool}|null $worker
 * @var array{enabled:bool, store:bool, analytics:bool, min_count:int, limit:int, profiles:list<array{name:string, label:string, more:int, rows:list<array{q:string, count:?int, status:string, shown:bool, decided_at:?string}>, hidden:list<array{q:string, count:?int, status:string, shown:bool, decided_at:?string}>}>} $popular
 */
$this->headTitle($this->translate('DRE Search'));
$form->setAttribute('action', $this->url('admin/dre-search/reindex'));
$form->prepare();
?>
<?= $this->pageTitle($this->translate('DRE Search'), 1, $this->translate('Maintenance')) ?>

<h2><?= $this->translate('Typesense status') ?></h2>

<p>
    <strong><?= $this->translate('Configured') ?>:</strong>
    <?php if ($configured): ?>
        <?= $this->translate('Yes') ?>
    <?php else: ?>
        <?= $this->translate('No — set the connection under Modules → DRE Search → Configure.') ?>
    <?php endif; ?>
</p>

<table class="tablesaw" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th><?= $this->translate('Search') ?></th>
            <th><?= $this->translate('Collection alias') ?></th>
            <th><?= $this->translate('Server reachable') ?></th>
            <th><?= $this->translate('Documents indexed') ?></th>
            <th><?= $this->translate('Index state') ?></th>
            <th><?= $this->translate('Last run') ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($profiles as $p): ?>
        <tr>
            <th scope="row"><?= $this->escapeHtml($this->translate($p['label'])) ?></th>
            <td><code><?= $this->escapeHtml($p['collection']) ?></code></td>
            <td><?= $p['reachable'] ? $this->translate('Yes') : $this->translate('No') ?></td>
            <td>
                <?= $p['documents'] === null ? '—' : $this->escapeHtml((string) $p['documents']) ?>
                <?php if (!empty($p['error'])): ?>
                    <div class="error"><?= $this->escapeHtml($p['error']) ?></div>
                <?php endif; ?>
            </td>
            <td>
                <?php $state = $p['state']; ?>
                <strong><?= $this->escapeHtml($this->translate((string) ($state['status'] ?? 'Not built'))) ?></strong>
                <?php if ($p['public'] === 'paused'): ?>
                    <div class="error"><strong><?= $this->translate('Public search paused') ?></strong></div>
                    <?php if (!empty($state['dirty'])): ?>
                        <div><?= $this->translate('A full rebuild is required before this corpus answers again.') ?></div>
                        <?php if (!empty($state['dirty_reason'])): ?>
                            <div><small><?= $this->escapeHtml((string) $state['dirty_reason']) ?></small></div>
                        <?php endif; ?>
                    <?php else: ?>
                        <div><?= $this->escapeHtml(sprintf($this->translate('%d pending changes — more than can be hidden individually. Search resumes once the worker applies them.'), $p['pending'])) ?></div>
                    <?php endif; ?>
                <?php elseif ($p['public'] === 'hiding'): ?>
                    <div class="warning"><?= $this->escapeHtml(sprintf($this->translate('%d records hidden from public search until their changes are applied'), $p['pending'])) ?></div>
                <?php endif; ?>
                <?php if (!empty($p['oldest_pending'])): ?>
                    <div><small><?= $this->escapeHtml(sprintf($this->translate('Oldest pending change: %s UTC'), $p['oldest_pending'])) ?></small></div>
                <?php endif; ?>
                <?php if ($p['rejected'] !== []): ?>
                    <div class="error">
                        <?= $this->escapeHtml(sprintf($this->translate('Typesense rejected %d record(s); they are out of search until fixed and saved again:'), count($p['rejected']))) ?>
                        <?php foreach (array_slice($p['rejected'], 0, 20) as $rejectedId): ?>
                            <a href="<?= $this->escapeHtmlAttr($this->url('admin/id', ['controller' => 'item', 'id' => $rejectedId])) ?>">#<?= (int) $rejectedId ?></a>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
                <?php if (!empty($state['live_collection'])): ?>
                    <div><code><?= $this->escapeHtml((string) $state['live_collection']) ?></code></div>
                <?php endif; ?>
            </td>
            <td>
                <?php if (!empty($state['finished_at'])): ?>
                    <div><?= $this->escapeHtml((string) $state['finished_at']) ?> UTC</div>
                <?php endif; ?>
                <?php if (isset($state['last_duration_ms'])): ?>
                    <div><?= $this->escapeHtml(number_format(((int) $state['last_duration_ms']) / 1000, 1)) ?> s</div>
                <?php endif; ?>
                <?php if (isset($state['documents_imported'])): ?>
                    <div>
                        <?= $this->escapeHtml((string) $state['documents_imported']) ?> / <?= $this->escapeHtml((string) ($state['documents_attempted'] ?? 0)) ?>
                        <?= $this->translate('documents imported') ?>
                    </div>
                <?php endif; ?>
                <?php if (!empty($state['last_error_code'])): ?>
                    <div class="error"><?= $this->escapeHtml((string) $state['last_error_code']) ?></div>
                <?php endif; ?>
            </td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>

<h2><?= $this->translate('Incremental worker') ?></h2>
<p>
    <?php if ($worker === null): ?>
        <?= $this->translate('Worker state is unavailable.') ?>
    <?php elseif ($worker['alive']): ?>
        <?= $this->escapeHtml(sprintf($this->translate('Applying changes — last heartbeat %s UTC.'), (string) $worker['heartbeat'])) ?>
    <?php elseif ($worker['requested']): ?>
        <?= $this->translate('Changes are waiting for a worker. One starts with the next edit or search; use "Retry pending changes" to start it now.') ?>
    <?php else: ?>
        <?= $this->translate('Idle — no changes waiting.') ?>
    <?php endif; ?>
</p>

<h2><?= $this->translate('Search analytics') ?></h2>
<p>
    <?= $this->translate('Popular and zero-result queries reveal missing terminology and cataloguing gaps. Analytics is optional and requires Typesense search analytics with persistent storage.') ?>
</p>
<?php if ($analytics['enabled'] && $analytics['rows'] !== []): ?>
    <table class="tablesaw" data-tablesaw-mode="stack">
        <thead><tr>
            <th><?= $this->translate('Search') ?></th>
            <th><?= $this->translate('Signal') ?></th>
            <th><?= $this->translate('Query') ?></th>
            <th><?= $this->translate('Count') ?></th>
        </tr></thead>
        <tbody>
        <?php foreach ($analytics['rows'] as $row): ?>
            <tr>
                <td><?= $this->escapeHtml($this->translate($row['profile'])) ?></td>
                <td><?= $this->escapeHtml($this->translate($row['kind'])) ?></td>
                <td><?= $this->escapeHtml($row['q']) ?></td>
                <td><?= $this->escapeHtml((string) $row['count']) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
<?php else: ?>
    <p><?= $this->translate('No analytics data is available yet.') ?></p>
<?php endif; ?>

<h2 id="dre-search-popular"><?= $this->translate('Popular searches') ?></h2>
<p>
    <?= $this->escapeHtml(sprintf(
        $this->translate('Visitors see a query in the empty search box only once an editor approves it here. A candidate was run at least %1$d times and found something, but anyone can repeat a search until it counts: read each one before approving it. Up to %2$d approved queries are shown per corpus, most-run first.'),
        $popular['min_count'],
        $popular['limit'],
    )) ?>
</p>
<?php if (!$popular['enabled']): ?>
    <p class="warning"><?= $this->translate('Popular searches are turned off (popular_searches.enabled in config/local.config.php). Decisions made now apply once they are turned on.') ?></p>
<?php endif; ?>
<?php if (!$popular['store']): ?>
    <p class="error"><?= $this->translate('Popular-search decisions cannot be read: run the DRE Search upgrade under Modules. Until then no popular search is shown.') ?></p>
<?php elseif ($popular['profiles'] === []): ?>
    <p>
        <?= $popular['analytics']
            ? $this->translate('No query has become a candidate yet.')
            : $this->translate('No popular-query analytics are available. Provision analytics below; candidates appear here as visitors search.') ?>
    </p>
<?php else: ?>
    <?php
    $statusLabel = function (array $row) use ($popular): string {
        if ($row['status'] === 'pending') {
            return $this->translate('Awaiting review');
        }
        if ($row['status'] === 'hidden') {
            return $this->translate('Hidden');
        }
        if ($row['shown']) {
            return $popular['enabled']
                ? $this->translate('Approved: shown to visitors')
                : $this->translate('Approved: shown once popular searches are turned on');
        }
        return $row['count'] === null
            ? sprintf($this->translate('Approved, not shown: no longer run %d times, or it now finds nothing'), $popular['min_count'])
            : sprintf($this->translate('Approved, not shown: outside the top %d'), $popular['limit']);
    };
    $button = function (string $decision, string $label, string $query): string {
        return sprintf(
            '<button type="submit" class="button" name="%s" value="%s" aria-label="%s">%s</button>',
            $this->escapeHtmlAttr($decision),
            $this->escapeHtmlAttr($query),
            $this->escapeHtmlAttr(sprintf('%s: %s', $label, $query)),
            $this->escapeHtml($label),
        );
    };
    ?>
    <?php foreach ($popular['profiles'] as $corpus): ?>
        <h3><?= $this->escapeHtml($this->translate($corpus['label'])) ?></h3>
        <form method="post" action="<?= $this->escapeHtmlAttr($this->url('admin/dre-search/moderate')) ?>">
            <?= $this->formHidden($form->get('csrf')) ?>
            <input type="hidden" name="profile" value="<?= $this->escapeHtmlAttr($corpus['name']) ?>">
            <?php if ($corpus['rows'] !== []): ?>
                <table class="tablesaw" data-tablesaw-mode="stack">
                    <thead><tr>
                        <th><?= $this->translate('Query') ?></th>
                        <th><?= $this->translate('Times run') ?></th>
                        <th><?= $this->translate('Status') ?></th>
                        <th><?= $this->translate('Decision') ?></th>
                    </tr></thead>
                    <tbody>
                    <?php foreach ($corpus['rows'] as $row): ?>
                        <tr>
                            <td><?= $this->escapeHtml($row['q']) ?></td>
                            <td><?= $row['count'] === null ? '—' : $this->escapeHtml((string) $row['count']) ?></td>
                            <td>
                                <?= $this->escapeHtml($statusLabel($row)) ?>
                                <?php if ($row['decided_at'] !== null): ?>
                                    <div><small><?= $this->escapeHtml($row['decided_at']) ?> UTC</small></div>
                                <?php endif; ?>
                            </td>
                            <td>
                                <?php if ($row['status'] === 'pending'): ?>
                                    <?= $button('approve', $this->translate('Approve'), $row['q']) ?>
                                <?php else: ?>
                                    <?= $button('revoke', $this->translate('Revoke'), $row['q']) ?>
                                <?php endif; ?>
                                <?= $button('hide', $this->translate('Hide'), $row['q']) ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            <?php endif; ?>
            <?php if ($corpus['more'] > 0): ?>
                <p><?= $this->escapeHtml(sprintf($this->translate('%d more candidates await review; they are listed here as you decide on these.'), $corpus['more'])) ?></p>
            <?php endif; ?>
            <?php if ($corpus['hidden'] !== []): ?>
                <details>
                    <summary><?= $this->escapeHtml(sprintf($this->translate('Hidden queries (%d)'), count($corpus['hidden']))) ?></summary>
                    <table class="tablesaw" data-tablesaw-mode="stack">
                        <thead><tr>
                            <th><?= $this->translate('Query') ?></th>
                            <th><?= $this->translate('Times run') ?></th>
                            <th><?= $this->translate('Hidden on') ?></th>
                            <th><?= $this->translate('Decision') ?></th>
                        </tr></thead>
                        <tbody>
                        <?php foreach ($corpus['hidden'] as $row): ?>
                            <tr>
                                <td><?= $this->escapeHtml($row['q']) ?></td>
                                <td><?= $row['count'] === null ? '—' : $this->escapeHtml((string) $row['count']) ?></td>
                                <td><?= $this->escapeHtml((string) $row['decided_at']) ?> UTC</td>
                                <td><?= $button('revoke', $this->translate('Revoke'), $row['q']) ?></td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </details>
            <?php endif; ?>
        </form>
    <?php endforeach; ?>
<?php endif; ?>

<h2><?= $this->translate('Reindex') ?></h2>
<p>
    <?= $this->translate('Rebuild a search index from the current Omeka content. Each runs as a background job — you can keep working while it completes.') ?>
</p>

<?php if ($configured): ?>
    <?= $this->form()->openTag($form) ?>
    <?= $this->formHidden($form->get('csrf')) ?>
    <p class="dre-search-reindex-all">
        <button type="submit" class="button" name="drain_queue" value="1"><?= $this->translate('Retry pending changes') ?></button>
        <button type="submit" class="button" name="reindex_all" value="1">
            <?= $this->translate('Reindex all corpora') ?>
        </button>
        <span class="dre-search-reindex-all__hint" style="margin-inline-start:.5rem; color:#6c6357; font-size:.9em;">
            <?= $this->translate('Rebuilds every index in one background job, one corpus at a time.') ?>
        </span>
    </p>
    <p>
        <label>
            <input type="checkbox" name="allow_shrink" value="1">
            <?= $this->translate('Allow a smaller corpus') ?>
        </label>
        <span style="margin-inline-start:.5rem; color:#6c6357; font-size:.9em;">
            <?= $this->translate('A rebuild that would leave less than half of the live documents is refused, in case a scope setting is wrong. Tick this when the drop is intended.') ?>
        </span>
    </p>

    <h3><?= $this->translate('Or reindex a single corpus') ?></h3>
    <div class="dre-search-reindex-buttons">
        <?php foreach ($profiles as $p): ?>
            <button type="submit" class="button" name="profile" value="<?= $this->escapeHtmlAttr($p['name']) ?>">
                <?= $this->translate('Reindex') ?>: <?= $this->escapeHtml($this->translate($p['label'])) ?>
            </button>
        <?php endforeach; ?>
    </div>

    <h3><?= $this->translate('Stopwords and synonyms') ?></h3>
    <p>
        <button type="submit" class="button" name="sync_stopwords" value="1">
            <?= $this->translate('Sync stopwords and synonyms') ?>
        </button>
        <span style="margin-inline-start:.5rem; color:#6c6357; font-size:.9em;">
            <?= $this->translate('Re-uploads the English stopword set and the synonym set (data/stopwords.json, data/synonyms.json) to Typesense — no reindex needed. A full reindex does this too.') ?>
        </span>
    </p>

    <h3><?= $this->translate('Search analytics') ?></h3>
    <p>
        <button type="submit" class="button" name="provision_analytics" value="1">
            <?= $this->translate('Provision analytics') ?>
        </button>
        <span style="margin-inline-start:.5rem; color:#6c6357; font-size:.9em;">
            <?= $this->translate('Creates or refreshes per-corpus popular and zero-result query rules. Analytics must be enabled on the Typesense server.') ?>
        </span>
    </p>
    <?= $this->form()->closeTag() ?>
<?php else: ?>
    <p class="error"><?= $this->translate('Configure the Typesense connection before reindexing.') ?></p>
<?php endif; ?>
