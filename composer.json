{
  "name": "am-digital-research-environment/dre-search",
  "description": "Typesense-backed faceted search for the Africa Multiple DRE Omeka S instance. Indexes research items directly from the Omeka dashboard via MySQL; Typesense is optional.",
  "type": "omeka-module",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^8.2",
    "monolog/monolog": "^2.11.1",
    "typesense/typesense-php": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.56",
    "phpstan/phpstan": "^2.2.5",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "autoload": {
    "psr-4": {
      "DRESearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DRESearch\\Test\\": "tests/phpunit/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=phpcs.xml.dist Module.php src tests/phpunit tests/bootstrap.php",
    "analyse": "phpstan analyse --no-progress"
  },
  "config": {
    "prepend-autoloader": false,
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "php-http/discovery": false
    },
    "sort-packages": true
  }
}
