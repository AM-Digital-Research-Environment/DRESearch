{
  "name": "am-digital-research-environment/dre-search",
  "description": "Typesense-backed faceted search for the Africa Multiple DRE Omeka S instance. Indexes research items directly from the Omeka dashboard via MySQL; Typesense is optional.",
  "type": "omeka-module",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "typesense/typesense-php": "^6.0",
    "guzzlehttp/guzzle": "^7.10",
    "php-http/guzzle7-adapter": "^1.1",
    "http-interop/http-factory-guzzle": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.56",
    "phpstan/phpstan": "^2.2.5",
    "squizlabs/php_codesniffer": "^4.0.1"
  },
  "autoload": {
    "psr-4": {
      "DRESearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DRESearch\\Test\\": "tests/phpunit/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 Module.php src tests/phpunit",
    "analyse": "phpstan analyse --no-progress"
  }
}
