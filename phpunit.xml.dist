<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnWarning="true"
         failOnNotice="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true">
    <!-- Random order: a test that passes only after another one (shared
         static state, a leftover setting, a Typesense collection someone
         else created) fails here instead of hiding until the suite is
         reordered. The run prints its seed; pass it back with PHPUnit's
         random-order-seed option to repeat an order. A risky test (one that
         asserts nothing, for instance) fails too. -->
    <testsuites>
        <testsuite name="DRESearch">
            <directory>tests/phpunit</directory>
        </testsuite>
    </testsuites>
    <!-- Fail on deprecations/notices/warnings this module's code triggers
         (PHP 8.5 in production); indirect ones from Omeka core are reported
         by Omeka, not here. -->
    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
            <file>Module.php</file>
        </include>
    </source>
</phpunit>
