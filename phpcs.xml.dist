<?xml version="1.0"?>
<ruleset name="DRESearch">
    <description>PSR-12 for module PHP, with long SQL, translation strings and array-shape annotations permitted.</description>
    <rule ref="PSR12"/>
    <!-- PSR-12's 120-column recommendation is advisory, not a required limit. -->
    <rule ref="Generic.Files.LineLength"><severity>0</severity></rule>
    <!-- Omeka loads the module class before Composer during first installation. -->
    <rule ref="PSR1.Files.SideEffects"><exclude-pattern>*/Module.php</exclude-pattern></rule>
</ruleset>
