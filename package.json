{
  "name": "dre-search-client",
  "version": "1.20.1",
  "description": "Svelte client for the DRESearch Omeka S module — faceted search (research items + research projects + publications + podcasts + YouTube videos + people + research sections + organisations + genres + languages + locations + subjects & tags) backed by Typesense.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:version": "node scripts/check-version-consistency.mjs",
    "lint:schema": "php scripts/check-profile-schema.php",
    "lint": "npm run lint:tokens && npm run lint:version && npm run lint:schema && eslint src/svelte tests/frontend && prettier --check \"src/svelte/**/*.{ts,svelte}\" \"tests/frontend/**/*.ts\" \"*.{ts,json,md}\"",
    "lint:fix": "eslint src/svelte tests/frontend --fix && prettier --write \"src/svelte/**/*.{ts,svelte}\" \"tests/frontend/**/*.ts\" \"*.{ts,json,md}\"",
    "format": "prettier --write \"src/svelte/**/*.{ts,svelte}\" \"tests/frontend/**/*.ts\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.5",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
