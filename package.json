{
  "name": "dre-search-client",
  "version": "1.36.0",
  "description": "Svelte client for the DRESearch Omeka S module — faceted search (research items + research projects + publications + podcasts + YouTube videos + people + research sections + organisations + genres + languages + locations + subjects & tags) backed by Typesense.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run check:size",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:maplibre": "node scripts/check-maplibre-pins.mjs",
    "capture:lighthouse": "node scripts/lighthouse/capture.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vite build && playwright test",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:version": "node scripts/check-version-consistency.mjs",
    "bump": "node scripts/bump-version.mjs",
    "lint:schema": "php scripts/check-profile-schema.php",
    "lint:i18n": "php scripts/build-translations.php --check",
    "lint:docblocks": "node scripts/check-docblocks.mjs",
    "i18n": "php scripts/build-translations.php",
    "lint": "npm run lint:tokens && npm run lint:version && npm run lint:schema && npm run lint:i18n && npm run lint:docblocks && eslint src/svelte tests scripts playwright.config.ts && prettier --check \"src/svelte/**/*.{ts,svelte,css}\" \"tests/frontend/**/*.ts\" \"tests/browser/**/*.ts\" \"*.{ts,json,md}\"",
    "lint:fix": "eslint src/svelte tests scripts playwright.config.ts --fix && prettier --write \"src/svelte/**/*.{ts,svelte,css}\" \"tests/frontend/**/*.ts\" \"tests/browser/**/*.ts\" \"*.{ts,json,md}\"",
    "format": "prettier --write \"src/svelte/**/*.{ts,svelte,css}\" \"tests/frontend/**/*.ts\" \"tests/browser/**/*.ts\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.7"
  }
}
